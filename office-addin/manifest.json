{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "id": "01d979fb-0f5f-4a7e-9790-c35426b37ea8",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "name": {
    "short": "Global Advocate (ADVTest)",
    "full": "Global Advocate matter workspace (ADVTest POC)"
  },
  "description": {
    "short": "File, save and send matter documents.",
    "full": "Save Word documents to a matter, send them as Outlook drafts, file emails to a matter and attach matter documents to emails."
  },
  "developer": {
    "name": "ADVTest POC",
    "websiteUrl": "https://localhost:3000",
    "privacyUrl": "https://localhost:3000",
    "termsOfUseUrl": "https://localhost:3000"
  },
  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },
  "accentColor": "#0F6E5A",
  "localizationInfo": {
    "defaultLanguageTag": "en-us",
    "additionalLanguages": []
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "Mailbox.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "validDomains": [],
  "extensions": [
    {
      "requirements": {
        "scopes": [
          "mail",
          "document"
        ]
      },
      "runtimes": [
        {
          "id": "FileToMatterRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=file"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowFileToMatter",
              "type": "openPage",
              "pinnable": false
            }
          ],
          "requirements": {
            "scopes": [
              "mail"
            ],
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ]
          }
        },
        {
          "id": "AttachFromMatterRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=attach"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowAttachFromMatter",
              "type": "openPage",
              "pinnable": false
            }
          ],
          "requirements": {
            "scopes": [
              "mail"
            ],
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ]
          }
        },
        {
          "id": "SaveToMatterRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=save"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowSaveToMatter",
              "type": "openPage",
              "pinnable": false
            }
          ],
          "requirements": {
            "scopes": [
              "document"
            ]
          }
        },
        {
          "id": "SendAsAttachmentRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=send"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowSendAsAttachment",
              "type": "openPage",
              "pinnable": false
            }
          ],
          "requirements": {
            "scopes": [
              "document"
            ]
          }
        }
      ],
      "ribbons": [
        {
          "contexts": [
            "mailRead"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "msgReadMatterGroup",
                  "label": "Global Advocate",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "msgReadFileToMatterButton",
                      "type": "button",
                      "label": "File to Matter",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "File to Matter",
                        "description": "Save this email and its attachments to a matter folder."
                      },
                      "actionId": "ShowFileToMatter"
                    }
                  ]
                }
              ]
            }
          ],
          "requirements": {
            "scopes": [
              "mail"
            ],
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ]
          }
        },
        {
          "contexts": [
            "mailCompose"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "msgComposeMatterGroup",
                  "label": "Global Advocate",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "msgComposeAttachFromMatterButton",
                      "type": "button",
                      "label": "Attach from Matter",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Attach from Matter",
                        "description": "Attach documents from a matter workspace."
                      },
                      "actionId": "ShowAttachFromMatter"
                    }
                  ]
                }
              ]
            }
          ],
          "requirements": {
            "scopes": [
              "mail"
            ],
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ]
          }
        },
        {
          "contexts": [
            "default"
          ],
          "tabs": [
            {
              "id": "GlobalAdvocateTab",
              "label": "Global Advocate",
              "groups": [
                {
                  "id": "MatterWorkspaceGroup",
                  "label": "Matter workspace",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "SaveToMatterButton",
                      "type": "button",
                      "label": "Save to Matter",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Save to Matter",
                        "description": "Save this document into a matter folder."
                      },
                      "actionId": "ShowSaveToMatter"
                    },
                    {
                      "id": "SendAsAttachmentButton",
                      "type": "button",
                      "label": "Send as Attachment",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Send as Attachment",
                        "description": "Create an Outlook draft with this document attached."
                      },
                      "actionId": "ShowSendAsAttachment"
                    }
                  ]
                }
              ]
            }
          ],
          "requirements": {
            "scopes": [
              "document"
            ]
          }
        }
      ]
    }
  ]
}
