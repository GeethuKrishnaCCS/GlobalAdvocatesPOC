{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json#",
  "manifestVersion": "1.22",
  "version": "1.0.7",
  "id": "01d979fb-0f5f-4a7e-9790-c35426b37ea8",
  "localizationInfo": {
    "defaultLanguageTag": "en-us"
  },
  "developer": {
    "name": "ADVTest POC",
    "websiteUrl": "https://localhost:3000",
    "privacyUrl": "https://localhost:3000",
    "termsOfUseUrl": "https://localhost:3000"
  },
  "name": {
    "short": "Global Advocate DEV",
    "full": "Global Advocate DEV (ADVTest POC, dev server)"
  },
  "description": {
    "short": "DEV copy for testing: loads from the dev server (https://localhost:3000).",
    "full": "Developer copy of Global Advocate for the E2E test account: Word, Excel and PowerPoint (Save to Matter, Send as Attachment) and Outlook (File to Matter, Attach from Matter)."
  },
  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },
  "accentColor": "#0F6E5A",
  "validDomains": [
    "https://localhost:3000"
  ],
  "showLoadingIndicator": false,
  "isFullScreen": false,
  "defaultBlockUntilAdminAction": false,
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "Document.ReadWrite.User",
          "type": "Delegated"
        },
        {
          "name": "MailboxItem.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "extensions": [
    {
      "requirements": {
        "scopes": [
          "document",
          "workbook",
          "presentation",
          "mail"
        ]
      },
      "runtimes": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "AddinCommands",
                "minVersion": "1.1"
              }
            ]
          },
          "id": "SaveToMatterRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=save"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowSaveToMatter",
              "type": "openPage",
              "view": "SaveToMatter"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "AddinCommands",
                "minVersion": "1.1"
              }
            ]
          },
          "id": "SendAsAttachmentRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=send"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowSendAsAttachment",
              "type": "openPage",
              "view": "SendAsAttachment"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ]
          },
          "id": "FileToMatterRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=file"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowFileToMatter",
              "type": "openPage",
              "view": "FileToMatter",
              "pinnable": true
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ]
          },
          "id": "AttachFromMatterRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html?view=attach"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowAttachFromMatter",
              "type": "openPage",
              "view": "AttachFromMatter"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.10"
              }
            ]
          },
          "id": "AutoRunRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/commands.html",
            "script": "https://localhost:3000/launchevent.js"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "onNewMessageComposeHandler",
              "type": "executeFunction"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "AddinCommands",
                "minVersion": "1.1"
              }
            ],
            "scopes": [
              "document",
              "workbook",
              "presentation"
            ],
            "formFactors": [
              "desktop"
            ]
          },
          "contexts": [
            "default"
          ],
          "tabs": [
            {
              "id": "GlobalAdvocateTab",
              "label": "Global Advocate DEV",
              "groups": [
                {
                  "id": "MatterWorkspaceGroup",
                  "label": "Matter workspace",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "SaveToMatterButton",
                      "type": "button",
                      "label": "Save to Matter",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Save to Matter",
                        "description": "Save this document into a matter folder."
                      },
                      "actionId": "ShowSaveToMatter"
                    },
                    {
                      "id": "SendAsAttachmentButton",
                      "type": "button",
                      "label": "Send as Attachment",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Send as Attachment",
                        "description": "Create an Outlook draft with this document attached."
                      },
                      "actionId": "ShowSendAsAttachment"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ],
            "scopes": [
              "mail"
            ],
            "formFactors": [
              "desktop"
            ]
          },
          "contexts": [
            "mailRead"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "MatterReadGroup",
                  "label": "Global Advocate DEV",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "FileToMatterButton",
                      "type": "button",
                      "label": "File to Matter",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "File to Matter",
                        "description": "File this email and its attachments into a matter folder."
                      },
                      "actionId": "ShowFileToMatter"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ],
            "scopes": [
              "mail"
            ],
            "formFactors": [
              "desktop"
            ]
          },
          "contexts": [
            "mailCompose"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "MatterComposeGroup",
                  "label": "Global Advocate DEV",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "AttachFromMatterButton",
                      "type": "button",
                      "label": "Attach from Matter",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Attach from Matter",
                        "description": "Attach documents from a matter to this email."
                      },
                      "actionId": "ShowAttachFromMatter"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "alternates": [
        {
          "alternateIcons": {
            "icon": {
              "size": 32,
              "url": "https://localhost:3000/assets/icon-32.png"
            },
            "highResolutionIcon": {
              "size": 64,
              "url": "https://localhost:3000/assets/icon-64.png"
            }
          }
        }
      ],
      "autoRunEvents": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.10"
              }
            ],
            "scopes": [
              "mail"
            ]
          },
          "events": [
            {
              "type": "newMessageComposeCreated",
              "actionId": "onNewMessageComposeHandler"
            }
          ]
        }
      ]
    }
  ]
}
