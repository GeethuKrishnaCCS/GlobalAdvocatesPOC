{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json#",
  "manifestVersion": "1.22",
  "version": "1.0.1",
  "id": "01d979fb-0f5f-4a7e-9790-c35426b37ea8",
  "localizationInfo": {
    "defaultLanguageTag": "en-us"
  },
  "developer": {
    "name": "ADVTest POC",
    "websiteUrl": "https://localhost:3000",
    "privacyUrl": "https://localhost:3000",
    "termsOfUseUrl": "https://localhost:3000"
  },
  "name": {
    "short": "Global Advocate (ADVTest)",
    "full": "Global Advocate matter workspace (ADVTest POC)"
  },
  "description": {
    "short": "Save Word documents to a matter and send them as Outlook drafts.",
    "full": "Save the open Word document into a matter folder, or create an Outlook draft with it attached."
  },
  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },
  "accentColor": "#0F6E5A",
  "validDomains": ["https://localhost:3000"],
  "showLoadingIndicator": false,
  "isFullScreen": false,
  "defaultBlockUntilAdminAction": false,
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "Document.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "extensions": [
    {
      "requirements": {
        "scopes": ["document"]
      },
      "runtimes": [
        {
          "requirements": {
            "capabilities": [{ "name": "AddinCommands", "minVersion": "1.1" }]
          },
          "id": "SaveToMatterRuntime",
          "type": "general",
          "code": { "page": "https://localhost:3000/taskpane.html?view=save" },
          "lifetime": "short",
          "actions": [{ "id": "ShowSaveToMatter", "type": "openPage", "view": "SaveToMatter" }]
        },
        {
          "requirements": {
            "capabilities": [{ "name": "AddinCommands", "minVersion": "1.1" }]
          },
          "id": "SendAsAttachmentRuntime",
          "type": "general",
          "code": { "page": "https://localhost:3000/taskpane.html?view=send" },
          "lifetime": "short",
          "actions": [{ "id": "ShowSendAsAttachment", "type": "openPage", "view": "SendAsAttachment" }]
        }
      ],
      "ribbons": [
        {
          "requirements": {
            "capabilities": [{ "name": "AddinCommands", "minVersion": "1.1" }],
            "scopes": ["document"],
            "formFactors": ["desktop"]
          },
          "contexts": ["default"],
          "tabs": [
            {
              "id": "GlobalAdvocateTab",
              "label": "Global Advocate",
              "groups": [
                {
                  "id": "MatterWorkspaceGroup",
                  "label": "Matter workspace",
                  "icons": [
                    { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                    { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                    { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                  ],
                  "controls": [
                    {
                      "id": "SaveToMatterButton",
                      "type": "button",
                      "label": "Save to Matter",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Save to Matter",
                        "description": "Save this document into a matter folder."
                      },
                      "actionId": "ShowSaveToMatter"
                    },
                    {
                      "id": "SendAsAttachmentButton",
                      "type": "button",
                      "label": "Send as Attachment",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/assets/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/assets/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Send as Attachment",
                        "description": "Create an Outlook draft with this document attached."
                      },
                      "actionId": "ShowSendAsAttachment"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "alternates": [
        {
          "alternateIcons": {
            "icon": { "size": 32, "url": "https://localhost:3000/assets/icon-32.png" },
            "highResolutionIcon": { "size": 64, "url": "https://localhost:3000/assets/icon-64.png" }
          }
        }
      ]
    }
  ]
}
