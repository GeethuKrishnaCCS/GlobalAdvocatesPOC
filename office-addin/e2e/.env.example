# Copy to e2e/.env (gitignored). Office on the web URLs of ADVTest files (ADVTestMatter01/ADVTestDocuments), dev06 must have access.
# Must contain a query string (Doc.aspx?sourcedoc=...), the sideload params are appended with &.
ADV_E2E_DOC_WORD=https://ccsdev01.sharepoint.com/sites/ADVTestMatter01/_layouts/15/Doc.aspx?sourcedoc=%7B<UniqueId>%7D&action=edit
ADV_E2E_DOC_EXCEL=
ADV_E2E_DOC_POWERPOINT=
# Optional: absolute folder that keeps a full-page screenshot of every run (e.g. the task folder). Unset = off.
ADV_E2E_SCREENSHOT_DIR=
